{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/alphaforge-ingest:*"
    },
    {
      "Sid": "ReadWriteCuratedBundle",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::alphaforge-data-ACCOUNT_ID/curated/*"
    },
    {
      "Sid": "CuratedDataMissingKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::alphaforge-data-ACCOUNT_ID",
      "Condition": {"StringLike": {"s3:prefix": "curated/*"}}
    },
    {
      "Sid": "RecordSourceRuns",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/alphaforge-sources"
    },
    {
      "Sid": "OptionalHeadlineSentiment",
      "Effect": "Allow",
      "Action": "comprehend:BatchDetectSentiment",
      "Resource": "*"
    }
  ]
}
